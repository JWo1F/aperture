<svg xmlns="http://www.w3.org/2000/svg" width={self.w} height={self.h} viewBox="0 0 {self.w} {self.h}">
  <defs>
    <radialGradient id="shell-glow" cx="0.2" cy="-0.2" r="0.9" gradientUnits="objectBoundingBox">
      <stop offset="0" stop-color={self.glow()}/>
      <stop offset="0.6" stop-color={self.glow_end()}/>
    </radialGradient>
  </defs>
  <rect width={self.w} height={self.h} fill={self.p.c("bg")}/>
  <rect width={self.w} height={self.h} fill="url(#shell-glow)"/>
  <slot/>
</svg>
