{use crate::view::layouts::Container}
{use crate::view::marketing::ApertureMark}
{use crate::view::primitives::{Icon, Rail}}
{use super::ThemeToggle}
<header class="sticky top-0 z-40 border-b border-line-soft bg-ground/75 backdrop-blur-xl backdrop-saturate-150">
  <Container class="flex h-14 items-center gap-4">
    <a href={self.site.url("/")} class="flex items-center gap-2.5 text-ink" aria-label="Aperture home">
      <ApertureMark class="size-6 text-accent"/>
      <span class="font-display text-[1.06rem] font-semibold tracking-[-0.02em]">Aperture</span>
      <span class="hidden font-label text-[0.6rem] text-ink-muted sm:inline">v{self.site.version()}</span>
    </a>
    <span class="hidden h-5 md:flex"><Rail/></span>
    <nav class="hidden items-center gap-0.5 md:flex" aria-label="Sections">
      {#for (label, path) in Self::LINKS}
      <a href={self.site.url(path)} class="rounded-md px-2.5 py-1.5 text-[0.88rem] text-ink-soft transition-colors hover:bg-raised hover:text-ink">{label}</a>
      {/for}
    </nav>
    <div class="ml-auto flex items-center gap-1">
      <ThemeToggle/>
      <a href={self.repo()} class="inline-grid size-9 place-items-center rounded-md text-ink-soft transition-colors hover:bg-raised hover:text-ink" aria-label="Source on GitHub">
        <Icon name="github-01" class="text-[1.1rem]"/>
      </a>
      <a href={self.download()} class="ml-1 hidden h-8 items-center gap-1.5 rounded-md bg-accent px-3 text-[0.85rem] font-medium text-white transition-colors hover:bg-accent-hover sm:inline-flex">
        <Icon name="download-04" class="text-[0.95rem]"/> Download
      </a>
    </div>
  </Container>
</header>
